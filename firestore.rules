rules_version = '2';
// NEXO - acesso por convite. Publicar este arquivo no Firebase Console antes de ativar o frontend.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function accountEmail() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedInWithGoogle() && accountEmail() == 'felipemrvip@gmail.com';
    }
    function hasInvite() {
      return signedInWithGoogle()
        && exists(/databases/$(database)/documents/invitations/$(accountEmail()))
        && get(/databases/$(database)/documents/invitations/$(accountEmail())).data.status == 'active';
    }
    function isAllowed() { return isAdmin() || hasInvite(); }
    function isOwner(userId) { return isAllowed() && request.auth.uid == userId; }
    function validState(d) {
      return d.keys().hasOnly(['uid','schemaVersion','revision','updatedAt','payload'])
        && d.keys().hasAll(['uid','schemaVersion','revision','updatedAt','payload'])
        && d.uid is string && d.uid.size() > 0 && d.uid.size() <= 128
        && d.schemaVersion == 1
        && d.revision is int && d.revision >= 1 && d.revision <= 2147483647
        && d.updatedAt is timestamp && d.updatedAt == request.time
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 700000;
    }
    match /invitations/{inviteEmail} {
      allow get: if signedInWithGoogle() && (isAdmin() || accountEmail() == inviteEmail);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['email','status','createdAt','updatedAt'])
        && request.resource.data.email == inviteEmail
        && inviteEmail == inviteEmail.lower()
        && inviteEmail.size() <= 254
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['email','status','createdAt','updatedAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['active','blocked']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{userId}/nexo/state {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && validState(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.uid == resource.data.uid
        && validState(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
